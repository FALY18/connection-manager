server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }
    
    listen {
        type = acct
        ipaddr = *
        port = 1813
    }
    
    authorize {
        filter_username
        preprocess
        rest
        
        if (ok) {
            update control {
                Auth-Type := Accept
            }
            update reply {
                Session-Timeout := 3600
                Idle-Timeout := 300
            }
        }
    }
    
    authenticate {
    }
    
    preacct {
        preprocess
        acct_unique
    }
    
    accounting {
        rest
    }
    
    post-auth {
        Post-Auth-Type REJECT {
            attr_filter.access_reject
        }
    }
}
