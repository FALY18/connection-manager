server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }
    
    listen {
        type = acct
        ipaddr = *
        port = 1813
    }
    
    authorize {
        preprocess
        files
    }
    
    authenticate {
        pap
    }
    
    accounting {
        detail
    }
    
    session {
    }
    
    post-auth {
        update reply {
            &Acct-Interim-Interval = 300
        }
    }
    
    preacct {
        preprocess
    }
}
