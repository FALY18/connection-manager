FROM php:8.2-fpm-alpine

# Update package index and install system dependencies in ONE layer
# Using --no-cache to reduce layer size while building
RUN apk update && apk add --no-cache \
    postgresql-dev \
    postgresql-client \
    libpng-dev \
    libzip-dev \
    zip \
    unzip \
    curl \
    git \
    openssl \
    linux-headers && \
    rm -rf /var/cache/apk/*

# Install PHP extensions in ONE layer
RUN docker-php-ext-install pdo pdo_pgsql pgsql gd zip bcmath sockets && \
    pecl install redis && \
    docker-php-ext-enable redis && \
    rm -rf /tmp/pear/

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer && \
    chmod +x /usr/local/bin/composer

WORKDIR /var/www/html

# Copy only composer files first (for maximum layer caching)
COPY composer.json composer.lock ./

# Install PHP dependencies (no-scripts to speed up)
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts --no-progress

# Copy application files (only necessary ones, rest excluded by .dockerignore)
COPY . .

# Set permissions
RUN chown -R www-data:www-data /var/www/html && \
    chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 8000

CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]