rest {
    connect_uri = "http://laravel:8000"
    
    tls {
    }
    
    authorize {
        uri = "${..connect_uri}/api/radius/auth"
        method = "post"
        body = "json"
        data = '{"username":"%{User-Name}","password":"%{User-Password}","mac":"%{Calling-Station-Id}","ip":"%{Framed-IP-Address}"}'
    }
    
    accounting {
        uri = "${..connect_uri}/api/radius/accounting/start"
        method = "post"
        body = "json"
        data = '{"username":"%{User-Name}","mac":"%{Calling-Station-Id}","ip":"%{Framed-IP-Address}","voucher_code":"%{User-Password}","session_id":"%{Acct-Session-Id}"}'
    }
    
    pool {
        start = 0
        min = 4
        max = 32
        spare = 1
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }
}
